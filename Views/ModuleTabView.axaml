<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SysInfo.ViewModels"
             xmlns:conv="using:SysInfo.Converters"
             xmlns:m="using:SysInfo.Models"
             x:Class="SysInfo.Views.ModuleTabView"
             x:DataType="vm:ModuleTabViewModel">

    <DockPanel>

        <!-- En-tête (PageHeader) : icône du module, titre, sous-titre du module ; à droite, état d'actualisation et actions -->
        <Border DockPanel.Dock="Top"
                Height="{StaticResource HeaderHeight}"
                Padding="{StaticResource HeaderPadding}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                    <TextBlock Classes="Caption" Text="{Binding StatusLine}" VerticalAlignment="Center" />
                    <Button Classes="Ghost Icon"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="Actualiser"
                            AutomationProperties.Name="Actualiser"
                            VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.arrow_clockwise}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                    <Border Classes="PageIcon">
                        <PathIcon Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                    </Border>
                    <TextBlock Classes="PageTitle" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Classes="Body" Foreground="{DynamicResource TextMuted}" Text="{Binding Subtitle}"
                               IsVisible="{Binding HasSubtitle}" VerticalAlignment="Center" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip.Tip="{Binding Subtitle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu : erreur éventuelle, squelette au premier chargement, puis les sections -->
        <ScrollViewer Padding="{StaticResource PagePadding}">
            <StackPanel Spacing="{StaticResource Space16}">

                <Border Classes="Card" IsVisible="{Binding HasError}">
                    <DockPanel>
                        <Panel DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0">
                            <PathIcon Data="{StaticResource Icon.error_circle}" Foreground="{DynamicResource Danger}"
                                      IsVisible="{Binding CanRetry}" />
                            <PathIcon Data="{StaticResource Icon.warning}" Foreground="{DynamicResource Warning}"
                                      IsVisible="{Binding NeedsElevation}" />
                        </Panel>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top"
                                Content="Réessayer" Command="{Binding RefreshCommand}"
                                IsVisible="{Binding CanRetry}" />
                        <StackPanel Spacing="{StaticResource Space4}">
                            <TextBlock Classes="CardTitle" Text="{Binding ErrorTitle}" />
                            <SelectableTextBlock Classes="Value" Foreground="{DynamicResource TextSecondary}"
                                                 Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Constats du module (Findings), les plus graves d'abord : icône d'état, message, recommandation -->
                <Border Classes="Card" IsVisible="{Binding HasFindings}">
                    <StackPanel Spacing="{StaticResource Space12}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                            <PathIcon Classes="CardIcon" Data="{StaticResource Icon.info}" />
                            <TextBlock Classes="CardTitle" Text="Constats" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource Space12}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Finding">
                                    <DockPanel>
                                        <Panel DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0">
                                            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.error_circle}"
                                                      Foreground="{DynamicResource Danger}" IsVisible="{Binding IsCritical}"
                                                      ToolTip.Tip="Critique" />
                                            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.warning}"
                                                      Foreground="{DynamicResource Warning}" IsVisible="{Binding IsWarning}"
                                                      ToolTip.Tip="Attention" />
                                            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.info}"
                                                      Foreground="{DynamicResource TextMuted}" IsVisible="{Binding IsInfo}"
                                                      ToolTip.Tip="Information" />
                                        </Panel>
                                        <TextBlock DockPanel.Dock="Right" Classes="Caption" Text="{Binding Code}"
                                                   VerticalAlignment="Top" Margin="12,2,0,0" />
                                        <StackPanel Spacing="{StaticResource Space4}">
                                            <SelectableTextBlock Classes="Body" Text="{Binding Message}" TextWrapping="Wrap" />
                                            <TextBlock Classes="Body" Foreground="{DynamicResource TextSecondary}"
                                                       Text="{Binding Recommendation}" TextWrapping="Wrap"
                                                       IsVisible="{Binding HasRecommendation}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Squelette : une carte de valeurs, une carte de métrique -->
                <StackPanel Spacing="{StaticResource Space16}" IsVisible="{Binding ShowSkeleton}" Classes.Pulse="{Binding ShowSkeleton}"
                            AutomationProperties.Name="Chargement du module">
                    <Border Classes="Card">
                        <StackPanel Spacing="{StaticResource Space12}">
                            <Border Classes="Skeleton" Width="120" Height="14" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Width="320" Height="12" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Width="260" Height="12" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Width="290" Height="12" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Card">
                        <StackPanel Spacing="{StaticResource Space12}">
                            <Border Classes="Skeleton" Width="96" Height="14" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Width="140" Height="32" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Height="6" />
                            <Border Classes="Skeleton" Height="56" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Chaque bloc est rendu par sa vue (ViewLocator : …ViewModel → …View) ;
                     les Metric consécutives forment un MetricGroup (cartes en ligne, graphiques dessous) -->
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource Space16}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>
