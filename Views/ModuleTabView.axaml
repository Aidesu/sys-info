<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SysInfo.ViewModels"
             xmlns:conv="using:SysInfo.Converters"
             xmlns:c="using:SysInfo.Controls"
             x:Class="SysInfo.Views.ModuleTabView"
             x:DataType="vm:ModuleTabViewModel">

    <DockPanel>

        <!-- En-tête (PageHeader) : icône du module, titre, sous-titre du module ; à droite, état d'actualisation et actions -->
        <Border DockPanel.Dock="Top"
                Height="{StaticResource HeaderHeight}"
                Padding="{StaticResource HeaderPadding}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                    <TextBlock Classes="Caption" Text="{Binding StatusLine}" VerticalAlignment="Center" />
                    <Button Classes="Ghost Icon"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="Actualiser"
                            AutomationProperties.Name="Actualiser"
                            VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource Icon.arrow_clockwise}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                    <Border Classes="PageIcon">
                        <PathIcon Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                    </Border>
                    <TextBlock Classes="PageTitle" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Classes="Body" Foreground="{DynamicResource TextMuted}" Text="{Binding Subtitle}"
                               IsVisible="{Binding HasSubtitle}" VerticalAlignment="Center" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="560" ToolTip.Tip="{Binding Subtitle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenu : erreur éventuelle, constats, squelette au premier chargement, puis les sections.
             Chaque bloc est dans un AnimatedHeight : quand il apparaît, disparaît ou change de taille, la suite
             de la page glisse au lieu de sauter. L'espacement est la marge basse de chaque bloc (un bloc replié
             ne laisse pas de trou). -->
        <ScrollViewer Padding="{StaticResource PagePadding}">
            <StackPanel>

                <c:AnimatedHeight IsCollapsed="{Binding !HasError}">
                    <Border Classes="Card" Margin="0,0,0,16">
                        <DockPanel>
                            <Panel DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0">
                                <PathIcon Data="{StaticResource Icon.error_circle}" Foreground="{DynamicResource Danger}"
                                          IsVisible="{Binding CanRetry}" />
                                <PathIcon Data="{StaticResource Icon.warning}" Foreground="{DynamicResource Warning}"
                                          IsVisible="{Binding NeedsElevation}" />
                            </Panel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Top"
                                    Content="Réessayer" Command="{Binding RefreshCommand}"
                                    IsVisible="{Binding CanRetry}" />
                            <StackPanel Spacing="{StaticResource Space4}">
                                <TextBlock Classes="CardTitle" Text="{Binding ErrorTitle}" />
                                <SelectableTextBlock Classes="Value" Foreground="{DynamicResource TextSecondary}"
                                                     Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </c:AnimatedHeight>

                <!-- Constats du module, les plus graves d'abord ; au-delà de quelques-uns, « Voir plus » -->
                <c:AnimatedHeight IsCollapsed="{Binding !FindingList.HasFindings}">
                    <Border Classes="Card" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Right" Classes="Caption" Text="{Binding FindingList.Summary}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                    <PathIcon Classes="CardIcon" Data="{StaticResource Icon.info}" />
                                    <TextBlock Classes="CardTitle" Text="Constats" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding FindingList.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FindingItemViewModel">
                                        <c:AnimatedHeight IsCollapsed="{Binding IsCollapsed}" AnimateOnLoad="{Binding AnimateIn}">
                                            <ContentControl Content="{Binding Finding}" Margin="0,0,0,12" />
                                        </c:AnimatedHeight>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="More" Command="{Binding FindingList.ToggleExpandedCommand}"
                                    IsVisible="{Binding FindingList.CanExpand}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                                    <TextBlock Text="{Binding FindingList.MoreText}" VerticalAlignment="Center" />
                                    <PathIcon Classes="MoreChevron" Classes.Open="{Binding FindingList.IsExpanded}"
                                              Data="{StaticResource Icon.chevron_down}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </c:AnimatedHeight>

                <!-- Squelette : une carte de valeurs, une carte de métrique -->
                <StackPanel Spacing="{StaticResource Space16}" IsVisible="{Binding ShowSkeleton}" Classes.Pulse="{Binding ShowSkeleton}"
                            Margin="0,0,0,16" AutomationProperties.Name="Chargement du module">
                    <Border Classes="Card">
                        <StackPanel Spacing="{StaticResource Space12}">
                            <Border Classes="Skeleton" Width="120" Height="14" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Width="320" Height="12" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Width="260" Height="12" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Width="290" Height="12" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Border Classes="Card">
                        <StackPanel Spacing="{StaticResource Space12}">
                            <Border Classes="Skeleton" Width="96" Height="14" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Width="140" Height="32" HorizontalAlignment="Left" />
                            <Border Classes="Skeleton" Height="6" />
                            <Border Classes="Skeleton" Height="56" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Chaque bloc est rendu par sa vue (ViewLocator : …ViewModel → …View) ;
                     les Metric consécutives forment un MetricGroup (cartes en ligne, graphiques dessous).
                     Fondu à l'arrivée des données ; hauteur animée quand un bloc grandit ou rétrécit. -->
                <ItemsControl Classes="Blocks" Classes.Loading="{Binding ShowSkeleton}" ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewModelBase">
                            <c:AnimatedHeight>
                                <ContentControl Content="{Binding}" Margin="0,0,0,16" />
                            </c:AnimatedHeight>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Outils : fonctions ciblées du module (module.json › functions), même source que les outils MCP -->
                <Border Classes="Card" IsVisible="{Binding HasTools}" Margin="0,0,0,16">
                    <StackPanel Spacing="{StaticResource Space12}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                            <PathIcon Classes="CardIcon" Data="{StaticResource Icon.search}" />
                            <TextBlock Classes="CardTitle" Text="Outils" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Consultations d'abord, puis les actions sous leur propre titre -->
                        <ItemsControl ItemsSource="{Binding ReadTools}" IsVisible="{Binding HasReadTools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource Space8}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Classes="Label" Text="Actions" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,8,0,0" IsVisible="{Binding HasActionTools}" />
                        <ItemsControl ItemsSource="{Binding ActionTools}" IsVisible="{Binding HasActionTools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="{StaticResource Space8}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>
