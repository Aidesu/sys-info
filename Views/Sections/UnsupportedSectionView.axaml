<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SysInfo.Converters"
             xmlns:vm="using:SysInfo.ViewModels.Sections"
             x:Class="SysInfo.Views.Sections.UnsupportedSectionView"
             x:DataType="vm:UnsupportedSectionViewModel">

    <Border Classes="Card">
        <StackPanel Spacing="{StaticResource Space4}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                <PathIcon Classes="CardIcon" IsVisible="{Binding HasIcon}"
                          Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                <TextBlock Classes="CardTitle" Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="Caption">
                <Run Text="Type de section inconnu :" />
                <Run Text="{Binding Type}" FontFamily="{StaticResource FontMono}" />
                <Run Text="(types pris en charge : KeyValue, Metric, Table, Usage)" />
            </TextBlock>
        </StackPanel>
    </Border>

</UserControl>
