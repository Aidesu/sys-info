<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SysInfo.ViewModels.Sections"
             x:Class="SysInfo.Views.Sections.UnsupportedSectionView"
             x:DataType="vm:UnsupportedSectionViewModel">

    <Border Classes="Card">
        <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock Classes="CardTitle" Text="{Binding Title}" />
            <TextBlock Classes="Caption">
                <Run Text="Type de section inconnu :" />
                <Run Text="{Binding Type}" FontFamily="{StaticResource FontMono}" />
                <Run Text="(types pris en charge : KeyValue, Metric, Table)" />
            </TextBlock>
        </StackPanel>
    </Border>

</UserControl>
