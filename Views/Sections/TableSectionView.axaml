<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SysInfo.ViewModels.Sections"
             x:Class="SysInfo.Views.Sections.TableSectionView"
             x:DataType="vm:TableSectionViewModel">

    <!-- Carte sans padding : titre et compteur, puis la grille (construite dans le code-behind) -->
    <Border Classes="Card Flush">
        <StackPanel>
            <DockPanel Margin="16,16,16,12">
                <TextBlock DockPanel.Dock="Right" Classes="Caption" Text="{Binding CountText}" VerticalAlignment="Center" />
                <TextBlock Classes="CardTitle" Text="{Binding Title}" />
            </DockPanel>
            <Grid Name="TableGrid" />
        </StackPanel>
    </Border>

</UserControl>
