<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:SysInfo.Converters"
             xmlns:vm="using:SysInfo.ViewModels.Sections"
             x:Class="SysInfo.Views.Sections.TableSectionView"
             x:DataType="vm:TableSectionViewModel">

    <!-- Carte sans padding : titre et compteur, puis la grille (construite dans le code-behind) -->
    <Border Classes="Card Flush">
        <StackPanel>
            <DockPanel Margin="16,16,16,12">
                <!-- Colonnes affichées (même menu qu'un clic droit sur l'en-tête) -->
                <Button DockPanel.Dock="Right" Classes="Ghost Small Icon" Click="OnColumnsClick" Margin="8,0,0,0"
                        ToolTip.Tip="Colonnes" AutomationProperties.Name="Colonnes affichées">
                    <PathIcon Width="14" Height="14" Data="{StaticResource Icon.settings}" />
                </Button>
                <TextBlock DockPanel.Dock="Right" Classes="Caption" Text="{Binding CountText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                    <PathIcon Classes="CardIcon" IsVisible="{Binding HasIcon}"
                              Data="{Binding Icon, Converter={x:Static conv:IconConverter.Instance}}" />
                    <TextBlock Classes="CardTitle" Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <!-- Défilement horizontal seulement si les colonnes ne tiennent pas dans la carte -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid Name="TableGrid" />
            </ScrollViewer>
            <Button Classes="More" Margin="8,4,8,8" Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding CanExpand}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                    <TextBlock Text="{Binding MoreText}" VerticalAlignment="Center" />
                    <PathIcon Classes="MoreChevron" Classes.Open="{Binding IsExpanded}" Data="{StaticResource Icon.chevron_down}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>

</UserControl>
