<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SysInfo.ViewModels.Tools"
             xmlns:c="using:SysInfo.Controls"
             x:Class="SysInfo.Views.Tools.FunctionToolView"
             x:DataType="vm:FunctionToolViewModel">

    <!-- Un outil : formulaire généré depuis module.json, bouton Exécuter (Simuler et confirmation pour une action),
         Arrêter pendant l'exécution, puis constats et sections du résultat -->
    <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <Border Classes="Badge Warning" Classes.Critical="{Binding IsCritical}" IsVisible="{Binding IsAction}">
                    <TextBlock Classes="Caption" Text="{Binding Tag}" />
                </Border>
                <TextBlock Classes="Caption" Text="{Binding Tag}" VerticalAlignment="Center"
                           IsVisible="{Binding !IsAction}" />
            </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="{StaticResource Space12}">

            <!-- Aide de l'outil (module.json › help) : repliée par défaut -->
            <StackPanel Spacing="{StaticResource Space4}" IsVisible="{Binding HasHelp}">
                <Button Classes="More" Command="{Binding ToggleHelpCommand}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Aide de l'outil">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space4}">
                        <PathIcon Width="14" Height="14" Data="{StaticResource Icon.info}" />
                        <TextBlock Text="À propos de cet outil" VerticalAlignment="Center" />
                        <PathIcon Classes="MoreChevron" Classes.Open="{Binding IsHelpExpanded}"
                                  Data="{StaticResource Icon.chevron_down}" />
                    </StackPanel>
                </Button>
                <c:AnimatedHeight IsCollapsed="{Binding !IsHelpExpanded}">
                    <SelectableTextBlock Classes="Body" Text="{Binding Help}" TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                </c:AnimatedHeight>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Parameters}" IsVisible="{Binding HasParameters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="{StaticResource Space16}" LineSpacing="{StaticResource Space12}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FunctionParameterViewModel">
                        <StackPanel Spacing="{StaticResource Space4}" MinWidth="160">
                            <TextBlock Classes="Caption" Text="{Binding Label}" />
                            <TextBox Text="{Binding Text}" IsVisible="{Binding IsText}" MinWidth="220"
                                     AutomationProperties.Name="{Binding Label}" />
                            <NumericUpDown Value="{Binding Number}" IsVisible="{Binding IsNumber}"
                                           Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                           Increment="{Binding Increment}" FormatString="0.##" MinWidth="140"
                                           AutomationProperties.Name="{Binding Label}" />
                            <CheckBox IsChecked="{Binding Flag}" IsVisible="{Binding IsFlag}"
                                      AutomationProperties.Name="{Binding Label}" />
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}"
                                      IsVisible="{Binding IsChoice}" MinWidth="140"
                                      AutomationProperties.Name="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}">
                <Button Content="Simuler" Command="{Binding PreviewCommand}" IsVisible="{Binding IsAction}"
                        ToolTip.Tip="Montre ce que l'action changerait, sans rien modifier" />
                <Button Classes="Primary" Content="{Binding RunLabel}" Command="{Binding RunCommand}" />
                <Button Classes="Ghost" Content="Arrêter" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
                <TextBlock Classes="Caption" Text="{Binding Status}" IsVisible="{Binding HasStatus}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" IsVisible="{Binding HasError}">
                <PathIcon Width="16" Height="16" Data="{StaticResource Icon.error_circle}" Foreground="{DynamicResource Danger}" />
                <SelectableTextBlock Classes="Body" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Résultat : déplié en douceur quand il arrive ou change de taille -->
            <c:AnimatedHeight>
            <StackPanel Spacing="{StaticResource Space12}">
            <ItemsControl ItemsSource="{Binding Findings}" IsVisible="{Binding HasFindings}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource Space8}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Results}" IsVisible="{Binding HasResult}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource Space12}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            </StackPanel>
            </c:AnimatedHeight>
        </StackPanel>
    </Expander>

</UserControl>
