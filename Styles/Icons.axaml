    </Styles.Resources>

    <!-- PathIcon garde le cadre 20 × 20 de l'icône (sinon chaque tracé serait étiré à ses propres bornes) -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="{StaticResource IconSize}" />
        <Setter Property="Height" Value="{StaticResource IconSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox Stretch="Uniform">
                    <Canvas Width="20" Height="20">
                        <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" />
                    </Canvas>
                </Viewbox>
            </ControlTemplate>
        </Setter>
    </Style>

</Styles>
