<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SysInfo.App"
             xmlns:local="using:SysInfo"
             xmlns:m="using:SysInfo.Models"
             RequestedThemeVariant="Dark">
             <!-- Sombre par défaut (thème de référence du design system). "Light" ou "Default" (suit l'OS) restent possibles. -->

    <Application.DataTemplates>
        <!-- Constat (Finding) : icône d'état, message, recommandation, code à droite ; utilisé par la page et par les outils -->
        <DataTemplate DataType="m:Finding">
            <DockPanel>
                <Panel DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0">
                    <PathIcon Width="16" Height="16" Data="{StaticResource Icon.error_circle}"
                              Foreground="{DynamicResource Danger}" IsVisible="{Binding IsCritical}" ToolTip.Tip="Critique" />
                    <PathIcon Width="16" Height="16" Data="{StaticResource Icon.warning}"
                              Foreground="{DynamicResource Warning}" IsVisible="{Binding IsWarning}" ToolTip.Tip="Attention" />
                    <PathIcon Width="16" Height="16" Data="{StaticResource Icon.info}"
                              Foreground="{DynamicResource TextMuted}" IsVisible="{Binding IsInfo}" ToolTip.Tip="Information" />
                </Panel>
                <TextBlock DockPanel.Dock="Right" Classes="Caption" Text="{Binding Code}" VerticalAlignment="Top" Margin="12,2,0,0" />
                <StackPanel Spacing="{StaticResource Space4}">
                    <SelectableTextBlock Classes="Body" Text="{Binding Message}" TextWrapping="Wrap" />
                    <TextBlock Classes="Body" Foreground="{DynamicResource TextSecondary}" Text="{Binding Recommendation}"
                               TextWrapping="Wrap" IsVisible="{Binding HasRecommendation}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SysInfo/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SysInfo/Styles/Controls.axaml" />
        <StyleInclude Source="avares://SysInfo/Styles/Typography.axaml" />
        <StyleInclude Source="avares://SysInfo/Styles/Icons.axaml" />
    </Application.Styles>
</Application>